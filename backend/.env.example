JWT_SECRET=change-me
PORT=5000

# Local database. scripts/start-local.sh updates this automatically when MongoDB runs inside WSL.
MONGODB_URI=mongodb://127.0.0.1:27017/certificate-verification

# Hyperledger Fabric local test-network settings.
FABRIC_ENV=local
FABRIC_CONNECTION_PROFILE=../blockchain/fabric/connection-profiles/connection-org1.json
FABRIC_WALLET_PATH=../blockchain/fabric/wallet
FABRIC_IDENTITY=bridgeService
FABRIC_CHANNEL=mychannel
FABRIC_CHAINCODE=certificates
FABRIC_MSP_ID=Org1MSP
FABRIC_DISCOVERY_ENABLED=true
FABRIC_DISCOVERY_AS_LOCALHOST=true
FABRIC_CERTIFICATE_ISSUED_EVENT=CertificateIssued

# Fabric-to-ICP bridge.
BRIDGE_ENABLED=true
ICP_HOST=http://127.0.0.1:4943
ICP_CANISTER_ID=
ICP_FETCH_ROOT_KEY=true
ICP_BRIDGE_IDENTITY_FILE=.icp-bridge-identity.json

# Local Kubo/IPFS.
IPFS_ENABLED=true
IPFS_API_URL=http://127.0.0.1:5001/api/v0
IPFS_GATEWAY_URL=http://127.0.0.1:8080/ipfs/

# Optional OAuth.
GOOGLE_CLIENT_ID=

# AI Certificate Auto-Extraction (Free Google AI Studio key: https://aistudio.google.com/)
GEMINI_API_KEY=
